generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id        String   @id @default(uuid())
  name      String
  birthDate DateTime? // For identity validation
  batch     Int      // Year of graduation
  phone     String?
  email     String?
  jobHistory JobHistory[]
  responses SurveyResponse[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batch])
  @@index([createdAt])
}

model JobHistory {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime? // Null means currently working
  isCurrent   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([isCurrent])
}

model SurveyQuestion {
  id          String   @id @default(uuid())
  questionEn  String   @default("")
  questionId  String   @default("")
  type        String   // text, multiple_choice, rating
  optionsEn   String?  // JSON string for options if multiple_choice
  optionsId   String?  // JSON string for options if multiple_choice
  order       Int      @default(0)
  isStandard  Boolean  @default(false)
  standardKey String?  @unique
  responses   SurveyResponse[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model SurveyResponse {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id])
  answer     String
  createdAt  DateTime @default(now())

  @@index([studentId])
  @@index([questionId])
  @@index([createdAt])
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model University {
  id        String   @id @default(uuid())
  name      String   @unique
  programs  ProgramStudy[]
  createdAt DateTime @default(now())
}

model ProgramStudy {
  id           String   @id @default(uuid())
  name         String
  level        String?  // jenjang (e.g., S1, D3)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([name, level, universityId])
  @@index([universityId])
}
